/**
 * Estadísticas del Dashboard (V010 OPTIMIZADO)
 * --------------------------------------------
 * ANTES: llamaba a getVistaCertificados() que a su vez lee 6 hojas
 *        (certificados, usuarios, cursos, unidades, tipo, firmas) -> 12 lecturas totales.
 * AHORA: construye localmente los ultimosCertificados usando los datos
 *        ya leídos -> solo 6 lecturas (50% menos tiempo).
 */
function getDashboardStats() {
  const certsRes = getAllRecords('certificados');
  const usersRes = getAllRecords('usuarios');
  const cursosRes = getAllRecords('cursos');
  const unidadesRes = getAllRecords('unidades');
  const disenosRes = getAllRecords('disenos');
  const consultasRes = getAllRecords('consulta');

  const certs = (certsRes && certsRes.data) || [];
  const users = (usersRes && usersRes.data) || [];
  const cursos = (cursosRes && cursosRes.data) || [];
  const unidades = (unidadesRes && unidadesRes.data) || [];
  const disenos = (disenosRes && disenosRes.data) || [];
  const consultas = (consultasRes && consultasRes.data) || [];

  // Mapas locales para construir ultimosCertificados sin llamar a getVistaCertificados
  const usersMap = {};
  users.forEach(u => { if (u && u.id) usersMap[String(u.id).trim()] = u; });
  const cursosMap = {};
  cursos.forEach(c => { if (c && c.id) cursosMap[String(c.id).trim()] = c; });
  const unidadesMap = {};
  unidades.forEach(u => { if (u && u.id) unidadesMap[String(u.id).trim()] = u; });

  const ultimos = certs.slice(-5).reverse().map(cert => {
    const user = usersMap[String(cert.usuario_id || '').trim()] || {};
    const curso = cursosMap[String(cert.curso_id || '').trim()] || {};
    const unidad = unidadesMap[String(curso.unidad_id || '').trim()] || {};
    return {
      id: cert.id || '',
      codigo: cert.codigo || '',
      cedula: user.cedula || '',
      nombre_completo: user.nombre_completo || '',
      nombre_curso: curso.nombre || '',
      unidad_codigo: unidad.codigo || 'CYT',
      fecha_curso: cert.fecha_curso || ''
    };
  });

  return {
    status: 'success',
    data: {
      totalCertificados: certs.length,
      totalUsuarios: users.length,
      totalCursos: cursos.length,
      totalUnidades: unidades.length,
      totalDisenos: disenos.length,
      totalVerificaciones: consultas.length,
      ultimosCertificados: ultimos
    }
  };
}
